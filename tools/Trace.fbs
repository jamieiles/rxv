namespace RXV.Trace;

enum Privilege : uint8 {
    U = 0,
    S = 1,
    M = 3
}

enum CSRId : uint16 {
    INVALID	    = 0x0000,
    MSTATUS     = 0x0300,
    MISA        = 0x0301,
    MIE         = 0x0304,
    MTVEC       = 0x0305,
    MCOUNTEREN  = 0x0306,
    MSCRATCH    = 0x0340,
    MEPC        = 0x0341,
    MCAUSE      = 0x0342,
    MTVAL       = 0x0343,
    MIP         = 0x0344,
    MCYCLE      = 0x0B00,
    MINSTRET    = 0x0B02,
    MCYCLEH     = 0x0B80,
    MINSTRETH   = 0x0B82,
    UCYCLE      = 0x0C00,
    UTIME       = 0x0C01,
    UCYCLEH     = 0x0C80,
    UTIMEH      = 0x0C81,
    MVENDORID   = 0x0F11,
    MARCHID     = 0x0F12,
    MIMPID      = 0x0F13,
    MHARTID     = 0x0F14
}

table Register {
	id:uint8;
    read:bool;
	value:uint32;
}

table CSRValue {
	id:CSRId;
	value:uint32;
}

table MemAccess {
	addr:uint32;
	value:uint32;
	size:uint8;
    read:bool;
}

table InstructionTrace {
	cycle_num:uint64;
	pc:uint32;
	instruction:uint32;
	gpr_accesses:[Register];
    mem_accesses:[MemAccess];
	csr_writes:[CSRValue];
    exception_raised:bool;
    privilege:Privilege;
}

table ProcessorTrace {
	instructions:[InstructionTrace];
}

root_type ProcessorTrace;
