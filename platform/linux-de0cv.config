# DE0-CV on top of linux-defconfig, merge with
#
#   scripts/kconfig/merge_config.sh arch/riscv/configs/defconfig \
#       linux-defconfig linux-de0cv.config
#
# The PLIC (always built for RISC-V) in place of the Xilinx interrupt
# controller, a framebuffer console with PS/2 keyboard and mouse, no
# networking or SPI.
# CONFIG_XILINX_INTC is not set
# CONFIG_NET is not set
# CONFIG_SPI is not set
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_ALTERA_PS2=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# /dev/fb0 for userspace, not needed by the framebuffer console
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
